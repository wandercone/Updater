<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN
  name="updater"
  author="wandercone"
  version="2026.07.09.01"
  launch="Tools/Updater"
  pluginURL="https://raw.githubusercontent.com/wandercone/Updater/main/plugin/updater.plg"
  support="https://github.com/wandercone/Updater/issues"
  
  
  icon="cloud-download "
>

<CHANGES>
<![CDATA[

### 2026.07.09.01

chore: add icon

### 2026.07.09

feat: automatic patch updates

### 2026.05.29.01

fix: all aboard the struggle-bus of "it worked when i tested it"


For older releases, see https://github.com/wandercone/Updater/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/updater/updater-2026.07.09.01-noarch-1.txz">
<URL>https://github.com/wandercone/Updater/releases/download/2026.07.09.01/updater-2026.07.09.01-noarch-1.txz</URL>
<SHA256>5636ee4c5b355406a6f167c0ae2a4235e486e1940072cd663c761fca2dbf84af</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/updater/updater.cron">
<INLINE>
# Generated updater plugin scheduled tasks
# Disable/enable and change schedule from the plugin settings page
</INLINE>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/updater/updater-2026.07.09.01-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/updater/updater-*.txz 2>/dev/null | grep -v '2026.07.09.01')

# regenerate the plugin-owned cron file from saved state (also recreates it on boot)
/usr/bin/php /usr/local/emhttp/plugins/updater/include/cron.php --install-cron 2>/dev/null || true

# sync the plugin-owned cron file into the running cron state
/usr/local/sbin/update_cron

echo ""
echo "----------------------------------------------------"
echo " updater has been installed."
echo " Version: 2026.07.09.01"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg updater

rm -rf /usr/local/emhttp/plugins/updater
rm -rf /boot/config/plugins/updater

# sync removal into the running cron state
/usr/local/sbin/update_cron
]]>
</INLINE>
</FILE>

</PLUGIN>
