<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN
  name="updater"
  author="wandercone"
  version="2026.05.29.01"
  launch="Tools/Updater"
  pluginURL="https://raw.githubusercontent.com/wandercone/Updater/main/plugin/updater.plg"
  support="https://github.com/wandercone/Updater/issues"
  
  
  icon="cloud-download "
>

<CHANGES>
<![CDATA[

### 2026.05.29.01

fix: all aboard the struggle-bus of "it worked when i tested it"

### 2026.05.29

fix: just can't win with CSRF but this seems to work stable-ish

### 2026.05.10

fix: correct installation log positioning on page


For older releases, see https://github.com/wandercone/Updater/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/updater/updater-2026.05.29.01-noarch-1.txz">
<URL>https://github.com/wandercone/Updater/releases/download/2026.05.29.01/updater-2026.05.29.01-noarch-1.txz</URL>
<SHA256>0462ddb4d8fb3db5d7bdfbd0f4946411992975c89e6272cd5861c0d0727da725</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/updater/updater-2026.05.29.01-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/updater/updater-*.txz 2>/dev/null | grep -v '2026.05.29.01')

echo ""
echo "----------------------------------------------------"
echo " updater has been installed."
echo " Version: 2026.05.29.01"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg updater

rm -rf /usr/local/emhttp/plugins/updater
rm -rf /boot/config/plugins/updater
]]>
</INLINE>
</FILE>

</PLUGIN>
